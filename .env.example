# ============================================================
#  Deanery Infra — root .env.example
#  Copy to .env and fill in. One file covers all three sub-projects
#  (backend, frontend build args, docker-compose) — see .gitignore.
#
#  docker-compose.yml requires DB_PASSWORD: it will refuse to start rather
#  than fall back to a default password (S13).
#
#  Production database credentials exist ONLY in the .env on the deployment
#  server. Never in a local .env: tests and seed scripts load it.
# ============================================================

NODE_ENV=production
PORT=5000
FRONTEND_URL=http://frontend:5173

# ---- Database (required — no default password) ----
DB_HOST=mysql
DB_PORT=3306
DB_USER=infraseva_user
DB_PASSWORD=
DB_NAME=infraseva

# Stage A (Azure): MySQL in a container -> COMPOSE_PROFILES=localdb and DB_HOST=mysql.
# Stage B (institute server): DB_HOST=db.iitmandi.ac.in, leave COMPOSE_PROFILES unset.
# COMPOSE_PROFILES=localdb
# Set true on the server after the first successful boot, and never unset.
INFRA_EXPECT_EXISTING_DB=false
# Path (inside the backend container) to the database server's CA certificate, if it offers TLS.
# DB_SSL_CA=
# Number of reverse proxies in front of the backend (2 in production; the backend defaults to 0 outside docker).
TRUST_PROXY_HOPS=2

# ---- Mail (JE assignment / reminder emails) ----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ---- Sysadmin test tickets (X-Test-Role) ----
# On by default. Set to false to disable the endpoints and the header.
# MOCK_TESTING_ENABLED=true

# ---- Firebase Admin SDK (backend) ----
# Only needed outside Docker — docker-compose sets this to the mounted
# /app/certs/serviceAccountKey.json automatically.
# GOOGLE_APPLICATION_CREDENTIALS=./infra-backend-v2/serviceAccountKey.json

# ---- Firebase (frontend build args, VITE_ prefix required by Vite) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_API_URL=http://backend:5000/api
