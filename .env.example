# ============ Server ============
NODE_ENV=production
PORT=5000
FRONTEND_URL=http://localhost

# ============ MySQL ============
DB_HOST=mysql
DB_PORT=3306
DB_USER=deanery_user
DB_PASSWORD=changeme_strong_password
DB_ROOT_PASSWORD=changeme_root_password
DB_NAME=deanery_infra

# ============ SMTP (Optional: JE assignment emails) ============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ============ Firebase Frontend (Client SDK) ============
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ============ Firebase Backend (Admin SDK) ============
# serviceAccountKey.json must be mounted at: ./serviceAccountKey.json
# OR provide FIREBASE_SERVICE_ACCOUNT_JSON as base64-encoded JSON string

# ============ Frontend API URL ============
VITE_API_URL=http://backend:5000/api
