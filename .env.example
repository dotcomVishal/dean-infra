# ============================================================
#  Deanery Infra — root .env.example
#  Copy to .env and fill in. One file covers all three sub-projects
#  (backend, frontend build args, docker-compose) — see .gitignore.
#
#  docker-compose.yml requires DB_ROOT_PASSWORD and DB_PASSWORD: it will
#  refuse to start rather than fall back to a default password (S13).
# ============================================================

NODE_ENV=production
PORT=5000
FRONTEND_URL=http://frontend:5173

# ---- Database (required — no default password) ----
DB_HOST=mysql
DB_PORT=3306
DB_USER=deanery_user
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_NAME=deanery_infra

# ---- Mail (JE assignment / reminder emails) ----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ---- Sysadmin test tickets (X-Test-Role) ----
# On by default. Set to false to disable the endpoints and the header.
# MOCK_TESTING_ENABLED=true

# ---- Demo LDAP login (off by default; see Agent/demo-plan.md) ----
# Only the literal "true" turns it on. The password needs 12+ characters.
# DEMO_LDAP_ENABLED=true
# DEMO_LDAP_PASSWORD=

# ---- Firebase Admin SDK (backend) ----
# Only needed outside Docker — docker-compose sets this to the mounted
# /app/certs/serviceAccountKey.json automatically.
# GOOGLE_APPLICATION_CREDENTIALS=./infra-backend-v2/serviceAccountKey.json

# ---- Firebase (frontend build args, VITE_ prefix required by Vite) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_API_URL=http://backend:5000/api
