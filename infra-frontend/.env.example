# infra-frontend/.env.example
# Copy to .env.local and fill in:   cp .env.example .env.local
# Vite ONLY exposes variables prefixed with VITE_ to the browser.

# console.firebase.google.com -> Project settings -> General
#   -> Your apps -> Web app -> SDK setup and configuration -> Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend base URL (wired up in a later phase; api.ts still hardcodes localhost)
VITE_API_URL=http://localhost:5000/api
