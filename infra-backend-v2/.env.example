# infra-backend-v2/.env.example
# Copy to .env and fill in:   cp .env.example .env

# ---- Server ----
PORT=5000
FRONTEND_URL=http://localhost:5173

# ---- MySQL ----
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=deanery_infra

# ---- SMTP: JE assignment emails + escalation reminders ----
# mailer.js currently HARDCODES `secure: true` (implicit TLS), so use 465.
# If you need 587/STARTTLS, mail silently fails until that is fixed later.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
